# Firebase (Spark / free tier) — copy to .env and fill in from Firebase Console
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google Gemini (AI Studio) — never commit the real key
VITE_GEMINI_API_KEY=
# Working default: gemini-flash-lite-latest (gemini-2.5-flash-lite is blocked for new users)
# VITE_GEMINI_MODEL=gemini-flash-lite-latest
# Alternatives: gemini-3.1-flash-lite, gemini-3.5-flash-lite

# true (default) = only admins call Gemini live; tourists use local catalog silently
# VITE_GEMINI_ADMIN_ONLY=true

# false = no embedding API calls even for admin chat re-rank
# VITE_RAG_EMBEDDINGS=false

# Google Maps / Places / Street View (official APIs — not scraping)
# Enable: Places API (New), Street View Static API, Maps Embed API
# Restrict the browser key by HTTP referrer in Google Cloud Console
# VITE_GOOGLE_MAPS_API_KEY=
# Server/scripts only (preferred for photo download):
# GOOGLE_MAPS_API_KEY=

# Optional Booking.com affiliate ID (adds aid= to stay search links)
# VITE_BOOKING_AID=
